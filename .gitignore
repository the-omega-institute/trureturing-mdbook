# Generated checkouts, source projections, render output, and local caches.
/.upstream/
/.site-src/
/book/
/src/
/__pycache__/
/.pytest_cache/

# This repository intentionally tracks only the approved source surface.
/*
/.*
!/.gitignore
!/book.toml
!/README.md
!/NOTICE.md
!/LICENSE
!/scripts/
/scripts/*
!/scripts/build-site.py
!/scripts/escape_pseudo_links.py
!/scripts/source_tree.py
!/scripts/open_problems.py
!/scripts/verify-site.py
!/scripts/site_freshness.py
!/scripts/render_source_links.py
!/tests/
/tests/*
!/tests/test_build_site.py
!/tests/test_open_problems.py
!/tests/test_site_freshness.py
!/tests/test_source_links.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/.github/workflows/keepalive.yml
